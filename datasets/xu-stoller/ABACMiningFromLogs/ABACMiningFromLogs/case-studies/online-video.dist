# rules are equally likely
ruleDist(allG, .16)
ruleDist(allPG, .16)
ruleDist(allAdult, .17)
ruleDist(oldG, .17)
ruleDist(oldPG, .17)
ruleDist(oldAdult, .17)

# premium members are more active than regular members
userDist(child1r, .05)
userDist(child2r, .05)
userDist(teen1r, .05)
userDist(teen2r, .05)
userDist(adult1r, .05)
userDist(adult2r, .05)
userDist(child1p, .11)
userDist(child2p, .11)
userDist(teen1p, .12)
userDist(teen2p, .12)
userDist(adult1p, .12)
userDist(adult2p, .12)

