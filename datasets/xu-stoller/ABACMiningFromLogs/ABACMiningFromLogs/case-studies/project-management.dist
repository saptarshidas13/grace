resDist(proj12budget, .025)
resDist(proj12sched, .025)
# un-proprietary tasks
resDist(proj12task1a, .025)
resDist(proj12task2a, .025)
resDist(proj12task1, .025)
resDist(proj12task2, .025)
# proprietary tasks
resDist(proj12task1propa, .025)
resDist(proj12task2propa, .025)
resDist(proj12task1prop, .025)
resDist(proj12task2prop, .025)
# proj21
resDist(proj21budget, .025)
resDist(proj21sched, .025)
# un-proprietary tasks
resDist(proj21task1a, .025)
resDist(proj21task2a, .025)
resDist(proj21task1, .025)
resDist(proj21task2, .025)
# proprietary tasks
resDist(proj21task1propa, .025)
resDist(proj21task2propa, .025)
resDist(proj21task1prop, .025)
resDist(proj21task2prop, .025)
# proj22
resDist(proj22budget, .025)
resDist(proj22sched, .025)
# un-proprietary tasks
resDist(proj22task1a, .025)
resDist(proj22task2a, .025)
resDist(proj22task1, .025)
resDist(proj22task2, .025)
# proprietary tasks
resDist(proj22task1propa, .025)
resDist(proj22task2propa, .025)
resDist(proj22task1prop, .025)
resDist(proj22task2prop, .025)

# operations are equally likely, except read, which is more likely. 
opDist(read, .4)
opDist(approve, .1)
opDist(write, .1)
opDist(setStatus, .1)
opDist(request, .1)
opDist(setCost, .1)
opDist(setSchedule, .1)
