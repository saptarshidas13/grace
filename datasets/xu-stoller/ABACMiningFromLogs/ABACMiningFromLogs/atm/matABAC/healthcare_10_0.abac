resourceAttrib(carPat2carItem, type=HRitem, author=doc2, patient=carPat2, topics={cardiology}, treatingTeam=carTeam2, ward=carWard)
resourceAttrib(carPat2nursingItem, type=HRitem, author=carNurse2, patient=carPat2, topics={nursing}, treatingTeam=carTeam2, ward=carWard)
resourceAttrib(carPat2noteItem, type=HRitem, author=carAgent1, patient=carPat2, topics={note}, treatingTeam=carTeam2, ward=carWard)
resourceAttrib(carPat2HR, type=HR, patient=carPat2, treatingTeam=carTeam2, ward=carWard)
rule(MAT; specialties supseteqln {{oncology}}; topics supseteqln {{note}}, type in {HRitem}; {read};)
rule(MAT; position in {doctor}, teams supseteqln {{oncTeam1}}; topics supseteqln {{oncology}}, type in {HRitem}; {addItem};)
rule(MAT; teams supseteqln {{oncTeam2}}, specialties supseteqln {{oncology}}; patient in {carPat1}, ward in {carWard}; {addItem};)
rule(MAT; position in {doctor}, specialties supseteqln {{oncology}}; treatingTeam in {oncTeam2}; {read}; specialties > topics)
rule(MAT; ; ; {addItem};)
rule(MAT; position in {doctor}, teams supseteqln {{carTeam1}}; ward in {carWard}; {addNote};)
rule(MAT; agentFor supseteqln {{oncPat2}}; treatingTeam in {oncTeam1}, ward in {oncWard}; {addItem};)
rule(MAT; teams supseteqln {{oncTeam2}}; ; {addItem}; teams ] treatingTeam)
rule(MAT; position in {doctor}, teams supseteqln {{oncTeam2}}; treatingTeam in {carTeam2}; {read};)
unremovableResourceAttribs(type)