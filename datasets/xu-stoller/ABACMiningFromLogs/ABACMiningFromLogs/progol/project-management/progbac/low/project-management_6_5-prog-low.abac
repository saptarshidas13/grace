unremovableResourceAttribs(type)
up(A,B,request) :- expertiseU_superset_expertiseR(A,B), projectsU_contains_projectR(A,B).
up(A,B,write) :- projectsLedU_contains_projectR(A,B).
up(A,B,read) :- projectsU_contains_projectR(A,B).
up(A,B,write) :- adminRolesU(A,accountant), typeR(B,budget).
up(A,B,approve) :- adminRolesU(A,manager).
up(A,B,setStatus) :- tasksU_contains_ridR(A,B).
up(A,B,setCost) :- adminRolesU(A,accountant), projectsU_contains_projectR(A,B).
up(A,B,setSchedule) :- adminRolesU(A,planner), projectsU_contains_projectR(A,B).
up(A,B,read) :- typeR(B,budget), departmentU_equals_departmentR(A,B).
up(A,B,write) :- adminRolesU(A,planner), typeR(B,schedule).
