up(A,B,assignGrade) :- positionU(A,faculty), typeR(B,gradebook).
up(A,B,changeScore) :- crsTaughtU_contains_crsR(A,B).
up(A,B,read) :- positionU(A,faculty), typeR(B,roster), crsTaughtU_contains_crsR(A,B).
up(A,B,read) :- uidU(A,admissions2), typeR(B,application).
up(A,B,readMyScores) :- crsTakenU_contains_crsR(A,B).
up(A,B,read) :- uidU(A,admissions1), typeR(B,application).
up(A,B,setStatus) :- departmentU(A,admissions), typeR(B,application).
up(A,B,read) :- typeR(B,transcript), uidU_equals_studentR(A,B).
up(A,B,addScore) :- crsTaughtU_contains_crsR(A,B).
up(A,B,read) :- departmentU(A,registrar), typeR(B,transcript).
up(A,B,write) :- departmentU(A,registrar), typeR(B,roster).
up(A,B,read) :- isChairU(A,true), typeR(B,transcript), departmentU_equals_departmentR(A,B).
up(A,B,readScore) :- crsTaughtU_contains_crsR(A,B).
up(A,B,checkStatus) :- uidU_equals_studentR(A,B).
up(A,B,read) :- uidU(A,registrar2), typeR(B,roster).
up(A,B,read) :- uidU(A,registrar1), typeR(B,roster).
